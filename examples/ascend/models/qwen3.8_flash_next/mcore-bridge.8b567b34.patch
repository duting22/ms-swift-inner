+    restore_order = torch.empty(
+        total_tokens,
+        dtype=torch.long,
+        device=input_.device,
+    )
+
+    restore_order.scatter_(
+        0,
+        rank_major_positions,
+        torch.arange(
+            total_tokens,
+            device=input_.device,
+            dtype=torch.long,
+        ),
+    )
+
+    return input_.index_select(0, restore_order)
